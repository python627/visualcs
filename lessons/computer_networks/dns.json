    "notes": {
      "sections": [
        {
          "title": "What?",
          "content": "DNS maps a domain name such as example.com to an IP address."
        },
        {
          "title": "Example",
          "content": "Browser → DNS → 203.0.113.10 → server."
        },
        {
          "title": "Why?",
          "content": "People remember names; networks route using addresses."
        },
        {
          "title": "Remember",
          "content": "DNS finds the address; it does not deliver the web page itself."
        }
      ]
    },
