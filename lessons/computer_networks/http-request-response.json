    "quiz": {
      "question": "What does a 404 response mean?",
      "options": [
        "The resource was not found",
        "The request succeeded",
        "The server rebooted",
        "The DNS cache hit"
      ],
      "correct": 0
    },
    "discovery": {
      "title": "HTTP discovery",
      "summary": "HTTP separates a client's request from the server's status and response body."
    },
    "notes": {
      "sections": [
        {
          "title": "What?",
          "content": "HTTP carries a request from a client and a response from a server."
        },
        {
          "title": "Example",
          "content": "GET /page → 200 OK + content. A missing path can return 404."
        },
        {
          "title": "Why?",
          "content": "Status codes quickly describe success or failure."
        },
        {
          "title": "Remember",
          "content": "200 means success, 404 means missing, 500 means server error."
        }
      ]
    },
