      "content": "Watch one concrete sequence before you try it.",
      "steps": [
        {
          "action": "REQUEST",
          "state": {
            "flow": [
              "Browser",
              "GET /page",
              "Server"
            ],
            "status": "request sent"
          },
          "explanation": "The browser asks for a path with a method such as GET."
        },
        {
          "action": "STATUS",
          "state": {
            "flow": [
              "Server",
              "200 OK"
            ],
            "status": "resource found"
          },
          "explanation": "The server reports whether it handled the request."
        },
        {
          "action": "RESPONSE",
          "state": {
            "flow": [
              "200 OK",
              "HTML content",
              "Browser"
            ],
            "status": "page displayed"
          },
          "explanation": "The response body lets the browser render the page."
        }
      ],
      "conclusion": "The visual state changes because the concept follows a rule.",
