      "sections": [
        {
          "title": "What?",
          "content": "TCP emphasizes ordered, acknowledged delivery; UDP sends with fewer guarantees."
        },
        {
          "title": "Example",
          "content": "A file download usually chooses TCP; a live video call may choose UDP."
        },
        {
          "title": "Why?",
          "content": "The right choice depends on whether missing data can be tolerated."
        },
        {
          "title": "Remember",
          "content": "Do not reduce the choice to simply fast versus slow."
        }
      ]
