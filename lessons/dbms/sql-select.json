    "notes": {
      "sections": [
        {
          "title": "What?",
          "content": "SELECT chooses columns and WHERE filters rows."
        },
        {
          "title": "Example",
          "content": "SELECT Name FROM Students WHERE Age >= 20 returns Ben and Cara."
        },
        {
          "title": "Why?",
          "content": "The database applies the condition before returning the result set."
        },
        {
          "title": "Remember",
          "content": "SELECT = columns; WHERE = rows."
        }
      ]
    },
