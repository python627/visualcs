  "assessment": {
    "quiz": {
      "question": "What does ROLLBACK do after a failed transfer?",
      "options": [
        "Undo its changes",
        "Add another debit",
        "Delete the database",
        "Commit half"
      ],
      "correct": 0
    },
    "discovery": {
      "title": "Transaction discovery",
      "summary": "Transactions protect consistency by committing a complete unit or rolling it back."
    },
    "notes": {
      "sections": [
        {
          "title": "What?",
          "content": "A transaction is a group of changes treated as one unit."
        },
        {
          "title": "Example",
          "content": "Debit 20 from A, credit 20 to B, then COMMIT."
        },
        {
          "title": "Why?",
          "content": "ROLLBACK prevents a half-finished transfer from being saved."
        },
        {
          "title": "Remember",
          "content": "All changes commit together or are undone together."
        }
      ]
    },
    "alternate_explanations": [
