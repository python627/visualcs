  "assessment": {
    "quiz": {
      "question": "What makes the example a deadlock?",
      "options": [
        "A circular wait with held resources",
        "A fast CPU",
        "An empty queue",
        "A sorted list"
      ],
      "correct": 0
    },
    "discovery": {
      "title": "Deadlock discovery",
      "summary": "Deadlock reasoning connects what each process holds with what it requests."
    },
    "notes": {
      "sections": [
        {
          "title": "What?",
          "content": "A deadlock is a standstill: each process waits for a resource another process holds."
        },
        {
          "title": "Example",
          "content": "P1 holds R1 and waits for R2 while P2 holds R2 and waits for R1."
        },
        {
          "title": "Why?",
          "content": "No process can get the resource it needs, so no one can finish."
        },
        {
          "title": "Remember",
          "content": "Use the model shown; do not assume every cycle means deadlock without the holding/requesting evidence."
        }
      ]
    },
