    },
    "introduction": {
      "title": "Deadlocks: start here",
      "content": "A deadlock happens when processes wait forever for resources held by one another.",
      "points": [
        "Inspect a small resource graph and decide whether progress is possible."
      ],
      "visual": {
        "type": "array",
        "label": "Deadlocks",
        "items": [
          "What?",
          "Example",
          "Try it"
        ]
      }
    },
    "worked_example": {
      "title": "See one example",
      "content": "Watch one concrete sequence before you try it.",
      "steps": [
        {
          "action": "P1 HOLDS R1",
          "state": {
            "graph": "P1 → R1",
            "status": "one resource is held"
          },
          "explanation": "Holding a resource while waiting can block another process."
        },
        {
          "action": "P2 HOLDS R2",
          "state": {
            "graph": "P1 → R1; P2 → R2",
            "status": "both resources are held"
          },
          "explanation": "Now each process owns a different resource."
        },
        {
          "action": "CYCLE",
          "state": {
            "graph": "P1 holds R1 → waits R2; P2 holds R2 → waits R1",
            "status": "deadlocked"
          },
          "explanation": "The circular wait means neither process can continue."
        }
      ],
      "conclusion": "The visual state changes because the concept follows a rule.",
      "next": {
        "title": "Now you try.",
        "content": "Choose the next meaningful action."
      }
    },
