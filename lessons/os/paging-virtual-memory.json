                [
                  "PAGE",
                  "OFFSET"
                ],
                [
                  "1",
                  "4"
                ]
              ]
            },
            "result": "page 1, offset 4"
          },
          "explanation": "Separate the logical address into page number and offset."
        },
        {
          "action": "LOOK UP PAGE",
          "state": {
            "tables": {
              "PAGE TABLE": [
                [
                  "PAGE",
                  "FRAME"
                ],
                [
                  "1",
                  "0"
                ]
              ]
            },
            "result": "page 1 maps to frame 0"
          },
          "explanation": "The page table supplies the physical frame."
        },
        {
          "action": "BUILD ADDRESS",
          "state": {
            "tables": {
              "PHYSICAL": [
                [
                  "FRAME",
                  "OFFSET"
                ],
                [
                  "0",
                  "4"
                ]
              ]
            },
            "result": "frame 0, offset 4"
          },
          "explanation": "The offset stays the same after translation."
        }
      ],
      "conclusion": "The visual state changes because the concept follows a rule.",
